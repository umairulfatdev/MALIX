generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role              @default(USER)
  isActive      Boolean           @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  downloads     DownloadHistory[]
  notifications Notification[]
  profile       Profile?
  ratings       Rating[]
  reviews       Review[]
  sessions      Session[]
  watchHistory  WatchHistory[]
  watchProgress WatchProgress[]
  watchlist     Watchlist[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  country     String?
  language    String?  @default("en")
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Content {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String
  shortDesc       String?           @db.VarChar(500)
  type            ContentType
  releaseYear     Int?
  language        String?
  country         String?
  duration        Int?
  posterUrl       String?
  backdropUrl     String?
  trailerUrl      String?
  avgRating       Float?            @default(0)
  totalRatings    Int               @default(0)
  totalViews      Int               @default(0)
  totalDownloads  Int               @default(0)
  status          PublishStatus     @default(DRAFT)
  isFeatured      Boolean           @default(false)
  isTrending      Boolean           @default(false)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  downloadEnabled Boolean           @default(false)
  casts           ContentCast[]
  downloads       DownloadHistory[]
  downloadOptions DownloadOption[]
  drama           Drama?
  featured        FeaturedContent[]
  movie           Movie?
  ratings         Rating[]
  reviews         Review[]
  series          Series?
  videoSources    VideoSource[]
  history         WatchHistory[]
  progress        WatchProgress[]
  watchlist       Watchlist[]
  genres          Genre[]           @relation("ContentToGenre")

  @@index([type])
  @@index([status])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([title])
  @@index([releaseYear])
  @@index([avgRating])
  @@index([createdAt])
}

model Movie {
  id          String       @id @default(cuid())
  contentId   String       @unique
  directorId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  content     Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  director    Director?    @relation(fields: [directorId], references: [id])
  movieGenres MovieGenre[]

  @@index([directorId])
}

model Drama {
  id          String       @id @default(cuid())
  contentId   String       @unique
  directorId  String?
  totalEps    Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  content     Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  director    Director?    @relation(fields: [directorId], references: [id])
  dramaGenres DramaGenre[]
  episodes    Episode[]

  @@index([directorId])
}

model Series {
  id           String        @id @default(cuid())
  contentId    String        @unique
  directorId   String?
  totalSeasons Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  seasons      Season[]
  content      Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  director     Director?     @relation(fields: [directorId], references: [id])
  seriesGenres SeriesGenre[]

  @@index([directorId])
}

model Season {
  id           String        @id @default(cuid())
  seriesId     String
  seasonNumber Int
  title        String?
  description  String?
  posterUrl    String?
  releaseYear  Int?
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  episodes     Episode[]
  series       Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, seasonNumber])
  @@index([seriesId])
}

model Episode {
  id           String            @id @default(cuid())
  seasonId     String?
  dramaId      String?
  episodeNum   Int
  title        String
  description  String?
  thumbnailUrl String?
  duration     Int?
  videoUrl     String?
  trailerUrl   String?
  airDate      DateTime?
  status       PublishStatus     @default(DRAFT)
  totalViews   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  downloads    DownloadHistory[]
  drama        Drama?            @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  season       Season?           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]
  progress     WatchProgress[]

  @@index([seasonId])
  @@index([dramaId])
  @@index([status])
}

model Genre {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  dramaGenres  DramaGenre[]
  movieGenres  MovieGenre[]
  seriesGenres SeriesGenre[]
  contents     Content[]     @relation("ContentToGenre")

  @@index([slug])
}

model MovieGenre {
  movieId String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model DramaGenre {
  dramaId String
  genreId String
  drama   Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([dramaId, genreId])
}

model SeriesGenre {
  seriesId String
  genreId  String
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model CastMember {
  id          String        @id @default(cuid())
  name        String
  photoUrl    String?
  bio         String?
  birthDate   DateTime?
  country     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contentCast ContentCast[]

  @@index([name])
}

model ContentCast {
  id            String     @id @default(cuid())
  contentId     String
  castMemberId  String
  characterName String?
  roleType      String?
  order         Int        @default(0)
  castMember    CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  content       Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, castMemberId])
  @@index([contentId])
  @@index([castMemberId])
}

model Director {
  id        String    @id @default(cuid())
  name      String
  photoUrl  String?
  bio       String?
  birthDate DateTime?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dramas    Drama[]
  movies    Movie[]
  series    Series[]

  @@index([name])
}

model VideoSource {
  id        String   @id @default(cuid())
  contentId String
  episodeId String?
  url       String
  quality   String?
  type      String?  @default("mp4")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([episodeId])
}

model DownloadOption {
  id          String            @id @default(cuid())
  contentId   String
  episodeId   String?
  quality     String
  fileUrl     String
  fileSize    BigInt?
  format      String?           @default("mp4")
  isAvailable Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  downloads   DownloadHistory[]
  content     Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([episodeId])
  @@index([quality])
}

model DownloadHistory {
  id               String          @id @default(cuid())
  userId           String
  contentId        String
  episodeId        String?
  downloadOptionId String?
  quality          String
  fileSize         BigInt?
  status           String          @default("completed")
  ipAddress        String?
  createdAt        DateTime        @default(now())
  content          Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  downloadOption   DownloadOption? @relation(fields: [downloadOptionId], references: [id])
  episode          Episode?        @relation(fields: [episodeId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@index([createdAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([createdAt])
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  episodeId   String?
  progress    Float    @default(0)
  position    Int      @default(0)
  duration    Int      @default(0)
  isCompleted Boolean  @default(false)
  lastWatched DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode     Episode? @relation(fields: [episodeId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, episodeId])
  @@index([userId])
  @@index([lastWatched])
}

model WatchProgress {
  id         String   @id @default(cuid())
  userId     String
  contentId  String
  episodeId  String?
  position   Int      @default(0)
  duration   Int      @default(0)
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode    Episode? @relation(fields: [episodeId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, episodeId])
  @@index([userId])
  @@index([updatedAt])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([score])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  contentId    String
  title        String?
  body         String
  isHidden     Boolean  @default(false)
  isReported   Boolean  @default(false)
  reportReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([userId])
  @@index([isHidden])
}

model FeaturedContent {
  id        String    @id @default(cuid())
  contentId String
  section   String
  position  Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([section])
  @@index([isActive])
  @@index([position])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  imageUrl  String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

enum ContentType {
  MOVIE
  DRAMA
  SERIES
  DOCUMENTARY
  SHORT_FILM
  TRAILER
  ANIME
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  NEW_CONTENT
  NEW_EPISODE
  ANNOUNCEMENT
  ACCOUNT
  SYSTEM
}
