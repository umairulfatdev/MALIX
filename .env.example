# ============================================
# MALIX Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values
# ============================================

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/malix?schema=public"

# JWT secret for authentication (min 32 characters)
JWT_SECRET="your-long-random-secret-key-at-least-32-characters-long"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"